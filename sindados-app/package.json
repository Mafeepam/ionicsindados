{
  "name": "sindados-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:native": "tsc -p tsconfig.native-tests.json && node --test tests/*.test.cjs",
    "native:sync:ios": "npm run build && cap sync ios",
    "native:run:ios": "npm run build && cap run ios",
    "native:devices:ios": "cap run ios --list",
    "native:sync:android": "npm run build && cap sync android",
    "native:run:android": "npm run build && cap run android",
    "native:devices:android": "cap run android --list"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@ionic/angular": "^8.8.19",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@capacitor/cli": "8.6.2",
    "@ionic/lab": "^3.2.15",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  },
  "description": "MVP front-end Ionic + Angular — App do Associado SINDADOS-BA",
  "engines": {
    "node": ">=22.0.0 <23"
  }
}
